generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String           @id @default(cuid())
  name                String
  email               String           @unique
  passwordHash        String
  role                UserRole
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  alertDismissals     AlertDismissal[]
  comments            Comment[]
  reportsOwned        ExpenseReport[]  @relation("ReportOwner")
  approverAssignments ReportApprover[]
  historyEntries      ReportHistory[]
}

model ExpenseReport {
  id              String           @id @default(cuid())
  ownerId         String
  title           String
  startDate       DateTime
  endDate         DateTime
  status          ReportStatus     @default(DRAFT)
  total           Decimal          @default(0) @db.Decimal(12, 2)
  archived        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submittedAt     DateTime?
  alertDismissals AlertDismissal[]
  comments        Comment[]
  expenseLines    ExpenseLine[]
  owner           User             @relation("ReportOwner", fields: [ownerId], references: [id])
  approvers       ReportApprover[]
  history         ReportHistory[]

  @@index([ownerId])
  @@index([status])
  @@index([submittedAt])
  @@index([total])
}

model ExpenseLine {
  id          String          @id @default(cuid())
  reportId    String
  expenseDate DateTime
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory
  description String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  report      ExpenseReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([category])
}

model ReportApprover {
  id         String        @id @default(cuid())
  reportId   String
  approverId String
  assignedAt DateTime      @default(now())
  approver   User          @relation(fields: [approverId], references: [id])
  report     ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, approverId])
  @@index([approverId])
}

model ReportHistory {
  id        String        @id @default(cuid())
  reportId  String
  actorId   String
  oldStatus ReportStatus?
  newStatus ReportStatus?
  reason    String?
  createdAt DateTime      @default(now())
  actor     User          @relation(fields: [actorId], references: [id])
  report    ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

model Comment {
  id        String        @id @default(cuid())
  reportId  String
  authorId  String
  comment   String
  createdAt DateTime      @default(now())
  author    User          @relation(fields: [authorId], references: [id])
  report    ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

model AlertDismissal {
  id          String        @id @default(cuid())
  reportId    String
  approverId  String
  dismissedAt DateTime      @default(now())
  approver    User          @relation(fields: [approverId], references: [id])
  report      ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, approverId])
  @@index([approverId])
}

enum UserRole {
  EMPLOYEE
  APPROVER
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
}

enum ExpenseCategory {
  TRAVEL
  MEALS
  HOTEL
  SUPPLIES
  OTHER
}
